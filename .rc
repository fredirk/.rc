#!/bin/sh
GIT_REMOTE="${GIT_REMOTE:-https://github.com/fredirk/.rc.git}"
GIT_BRANCH="${GIT_BRANCH:-debian}"

git init --bare "$HOME/.rc.git"
git config --global alias.rc '!git --git-dir=$HOME/.rc.git --work-tree=$HOME'

git rc config --local status.showUntrackedFiles no
git rc remote add origin "$GIT_REMOTE"
git rc switch "$GIT_BRANCH"
